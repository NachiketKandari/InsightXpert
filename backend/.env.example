# =============================================================================
# InsightXpert — Environment Configuration
# Copy this file to .env.local and fill in your values.
# Lines starting with # are comments — remove the # to activate a setting.
# =============================================================================

# ── REQUIRED ─────────────────────────────────────────────────────────────────

# DeepSeek API key — get one at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# OpenRouter API key — get one at https://openrouter.ai/keys
# (only needed if using LLM_PROVIDER=openrouter; free models available)
# OPENROUTER_API_KEY=sk-or-v1-your-key-here

# JWT signing secret — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE-ME-replace-with-a-random-64-char-hex-string

# ── LLM PROVIDER ─────────────────────────────────────────────────────────────

# Which LLM backend to use: deepseek | openrouter | ollama  (default: deepseek)
LLM_PROVIDER=deepseek

# DeepSeek model (default: deepseek-v4-flash)
# DEEPSEEK_MODEL=deepseek-v4-flash

# OpenRouter (OpenAI-compatible gateway). Set OPENROUTER_API_KEY + LLM_PROVIDER=openrouter
# to switch. Model is env-driven so free-tier rotation needs no code change.
# Free models (see https://openrouter.ai/models?q=free):
#   nvidia/nemotron-3-ultra-550b-a55b:free (default, 1M ctx)
#   nvidia/nemotron-3-super-120b-a12b:free
#   openai/gpt-oss-120b:free, openai/gpt-oss-20b:free
#   qwen/qwen3-next-80b-a3b-instruct:free
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemma-4-31b-it:free, google/gemma-4-26b-a4b-it:free
#   cohere/north-mini-code:free
#   openrouter/free (auto-router)
# Get a key at https://openrouter.ai/keys
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers (recommended by OpenRouter)
# OPENROUTER_SITE_URL=
# OPENROUTER_APP_NAME=InsightXpert

# Ollama — local models, no API key needed (https://ollama.com)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ── DATABASE ─────────────────────────────────────────────────────────────────

# SQLAlchemy DB URL — SQLite is the default; no changes needed for local dev
# DATABASE_URL=sqlite:///./insightxpert.db

# ── CHROMADB (RAG VECTOR STORE) ───────────────────────────────────────────────

# Directory where ChromaDB persists data (relative to backend/)
# CHROMA_PERSIST_DIR=./chroma_data

# ── AUTH & ADMIN SEED USER ────────────────────────────────────────────────────
# These credentials are auto-created on first startup.
# Change ADMIN_SEED_PASSWORD before deploying publicly.

ADMIN_SEED_EMAIL=admin@insightxpert.ai
ADMIN_SEED_PASSWORD=changeme-use-a-strong-password

# JWT token lifetime in minutes (default: 1440 = 24 hours)
# ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ─────────────────────────────────────────────────────────────────────

# Comma-separated list of allowed frontend origins
# CORS_ORIGINS=http://localhost:3000

# ── AGENT TUNING ─────────────────────────────────────────────────────────────

# Max LLM tool-call iterations per request (default: 10)
# MAX_AGENT_ITERATIONS=10

# Max enrichment sub-tasks spawned by the orchestrator (default: 5)
# MAX_ORCHESTRATOR_TASKS=5

# Max rows returned per SQL query (default: 10000)
# SQL_ROW_LIMIT=10000

# SQL execution timeout in seconds (default: 30)
# SQL_TIMEOUT_SECONDS=30

# Python sandbox execution timeout for quant_analyst (default: 10)
# PYTHON_EXEC_TIMEOUT_SECONDS=10

# ── STARTUP / RUNTIME ────────────────────────────────────────────────────────

# Max seconds to wait for RAG seeding before continuing startup (default: 120)
# RAG_BOOTSTRAP_TIMEOUT_SECONDS=120

# In-memory conversation TTL in seconds (default: 7200 = 2 hours)
# CONVERSATION_TTL_SECONDS=7200

# Set to false to disable pre-computed stats context injection into prompts
# ENABLE_STATS_CONTEXT=true

# ── LOGGING ──────────────────────────────────────────────────────────────────

# DEBUG | INFO | WARNING | ERROR  (default: INFO)
LOG_LEVEL=INFO
