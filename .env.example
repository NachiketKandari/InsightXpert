# =============================================================================
# InsightXpert — Environment Configuration
# Copy to backend/.env.local and fill in your values
# =============================================================================

# --- LLM Provider -----------------------------------------------------------
# Choose: "deepseek", "openrouter" or "ollama"  (default: deepseek)
LLM_PROVIDER=deepseek

# --- DeepSeek (when LLM_PROVIDER=deepseek) ------------------------------------
# Get a key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-v4-flash

# --- OpenRouter (when LLM_PROVIDER=openrouter) ------------------------------
# Get a key at https://openrouter.ai/keys — model is env-driven.
# Free models (https://openrouter.ai/models?q=free), e.g.:
#   nvidia/nemotron-3-ultra-550b-a55b:free (default)
#   nvidia/nemotron-3-super-120b-a12b:free
#   openai/gpt-oss-120b:free, openai/gpt-oss-20b:free
#   qwen/qwen3-next-80b-a3b-instruct:free
#   meta-llama/llama-3.3-70b-instruct:free
#   google/gemma-4-31b-it:free
#   cohere/north-mini-code:free
#   openrouter/free (auto-router)
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_CHAT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Ollama (when LLM_PROVIDER=ollama) --------------------------------------
OLLAMA_MODEL=llama3.1
OLLAMA_BASE_URL=http://localhost:11434

# --- Database ----------------------------------------------------------------
DATABASE_URL=sqlite:///./insightxpert.db

# --- ChromaDB (RAG vector store) --------------------------------------------
CHROMA_PERSIST_DIR=./chroma_data

# --- Agent -------------------------------------------------------------------
MAX_AGENT_ITERATIONS=10
SQL_ROW_LIMIT=1000
SQL_TIMEOUT_SECONDS=30

# --- Auth ---------------------------------------------------------------
SECRET_KEY=change-me-to-a-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Logging -----------------------------------------------------------------
# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG

# --- Observability (Day 2+) --------------------------------------------------
OBS_DATABASE_PATH=./obs.db
